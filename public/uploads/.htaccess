# Prevent PHP execution in uploads directory
<FilesMatch "\.(php|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Also disable for Apache 2.4 syntax
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Disable directory listing
Options -Indexes
