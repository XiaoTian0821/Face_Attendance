# Face Attendance System - Environment Configuration
# Copy this file to .env and fill in your values

APP_NAME="Face Attendance"
APP_URL=http://localhost/Face_Attendance/public
APP_ENV=development
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_NAME=face_attendance
DB_USER=root
DB_PASS=

# Session
SESSION_NAME=face_att_sess
SESSION_LIFETIME=7200

# Face Recognition
FACE_MATCH_THRESHOLD=0.55
FACE_MIN_CONFIDENCE=0.45
FACE_MIN_FACE_SIZE=80
FACE_MAX_FACE_SIZE=420
FACE_MIN_BRIGHTNESS=40
FACE_MAX_BRIGHTNESS=220
FACE_MIN_SHARPNESS=20
FACE_DETECTION_CONFIDENCE=0.50
FACE_STABLE_FRAMES=3
REGISTRATION_SAMPLES=3
DUPLICATE_SCAN_INTERVAL=300

# Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_EXT=jpg,jpeg,png,pdf
